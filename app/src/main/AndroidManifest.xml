<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Firebase Cloud Messaging permissions -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 13+ (API 33+) permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- File provider for sharing files -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Hardware features (optional) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Frontend"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:exported="false"
            android:label="Chi tiết sản phẩm"/>

        <activity
            android:name=".ui.product.ImageViewerActivity"
            android:exported="false"
            android:label="Xem ảnh"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <activity
            android:name=".ui.auth.login.LoginActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.auth.register.RegisterActivity"
            android:exported="false"
            android:label="Đăng ký"/>

        <activity
            android:name=".ui.auth.otp.OTPActivity"
            android:exported="false"
            android:label="Xác thực OTP"/>

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:label="Trang chủ"/>

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:label="Hồ sơ cá nhân"/>

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:label="Chỉnh sửa hồ sơ"/>

        <activity
            android:name=".ui.profile.ChangePasswordActivity"
            android:exported="false"
            android:label="Đổi mật khẩu"/>

        <activity
            android:name=".ui.profile.DeliveryAddressActivity"
            android:exported="false"
            android:label="Địa chỉ giao hàng"/>

        <activity
            android:name=".ui.auth.forgotpassword.ForgotPasswordActivity"
            android:exported="false"
            android:label="Quên mật khẩu"/>

        <activity
            android:name=".ui.auth.forgotpassword.ResetPasswordActivity"
            android:exported="false"
            android:label="Đặt lại mật khẩu"/>

        <!-- Order Flow Activities -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false"
            android:label="Giỏ hàng"/>

        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false"
            android:label="Thanh toán"/>

        <activity
            android:name=".ui.order.OrderHistoryActivity"
            android:exported="false"
            android:label="Lịch sử đơn hàng"/>

        <activity
            android:name=".ui.order.OrderDetailActivity"
            android:exported="false"
            android:label="Chi tiết đơn hàng"/>

        <activity
            android:name=".ui.order.OrderTrackingActivity"
            android:exported="false"
            android:label="Theo dõi đơn hàng"/>

        <activity
            android:name=".ui.order.OrderSuccessActivity"
            android:exported="false"
            android:label="Đặt hàng thành công"/>

        <!-- Search Results -->
        <activity
            android:name=".ui.search.SearchResultsActivity"
            android:exported="false"
            android:label="Kết quả tìm kiếm"/>

        <!-- Chat Activities -->
        <activity
            android:name=".ui.chat.ChatListActivity"
            android:exported="false"
            android:label="Tin nhắn"/>

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:label="Chat"/>

        <activity
            android:name=".ui.chat.CreateConversationActivity"
            android:exported="false"
            android:label="Tạo cuộc trò chuyện"/>

        <!-- Payment Activities -->
        <activity
            android:name=".ui.payment.PaymentMethodActivity"
            android:exported="false"
            android:label="Chọn phương thức thanh toán"/>

        <activity
            android:name=".ui.payment.PaymentSuccessActivity"
            android:exported="false"
            android:label="Kết quả thanh toán"/>

        <activity
            android:name=".ui.checkout.VnpayWebViewActivity"
            android:exported="false"
            android:label="Thanh toán VNPay"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <!-- File Provider for sharing files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>